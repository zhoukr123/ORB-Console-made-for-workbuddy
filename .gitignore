# ============================================================
# ORB 控制台 · 开源仓库忽略清单
# 原则：只进「自研源码 + 文档 + 构建脚本」，一切
#   ① 专有/第三方打包产物   ② 含凭证的文件
#   ③ 运行时数据 / 缓存 / 审计   ④ 构建产物与备份
# 一律不得进入公开仓库。下面是分类清单。
# ============================================================

# ---------- 1. 红线：专有前端打包产物（开源即侵权） ----------
# WorkBuddy 专有前端资源（lib-chat-ui / server.js / workbuddy-provider /
# copilot-icon / ui-ardot 等），不属于本项目，绝不可再分发。
orb/voice_extract/
voice_extract/
# 图标备份目录：里面是 WorkBuddy 品牌素材（卡通头像 / 头像版图标）的历史备份，
# 属第三方素材，非本项目资产，也不参与构建，不再随仓库分发。
# （工具链只依赖 desktop/icon.png・icon-64.png・icon.ico 三个正式图标位。）
orb/.icon-backup/

# ---------- 2. 红线：含真实凭证的文件 ----------
# 桥接层运行时生成的访问令牌（36 字符 UUID），泄漏等于本机被远程控制。
orb/.bridge.json
.bridge.json
**/.bridge.json
# 子进程 PID 台账（运行时生成）
orb/.children-*.json
**/.children-*.json
# 各类凭据 / 令牌 / 私钥
**/.credentials.yaml
**/credentials.json
**/*token*.json
**/*.key
**/*.pem
**/*.pfx
**/.env
**/.env.*
!**/.env.example
# 本地覆盖配置（自用机的私有路径写在这里，**永不入库 / 永不随包**；
# 仓库里只留模板 orb/local.conf.example）
orb/local.conf
**/local.conf
!**/local.conf.example

# ---------- 3. Python 虚拟环境与模型权重（4GB 级） ----------
asr/venv/
asr/models/
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# ---------- 4. 本地运行数据 / 缓存 / 审计 / 历史 ----------
.orbdata/
orb/desktop/.orbdata/
history/
cache/
cache*/
.cache/
audit/
# ⚠️ 只对**项目根**的 workflows/ 生效：那是开发态录制产生的个人数据。
# 必须写成 /workflows/（锚定根）—— 不带前导斜杠的话，git 会在**任意层级**
# 匹配同名目录，把随仓库走的示例工作流 orb/desktop/extras/workflows/ 一起吃掉，
# 别人克隆仓库后打包就一个示例工作流都没有了。
/workflows/
!orb/desktop/extras/workflows/
**/.cache/
**/_backup/
**/_bench/
**/refs/
**/NVIDIA Corporation/

# ---------- 5. 构建产物 ----------
# ⚠️ git 的 .gitignore **不支持行尾注释**：`模式  # 注释` 里的 `#` 不是注释符，
#    整行会被当成一个永远匹配不到的模式（规则静默失效）。注释必须独占一行。
dist/
dist-electron/
out/
build/
release/
node_modules/
# 原生模块编译产物（源码 orb/native/src/ 保留）
orb/native/dist/
orb/native/**/*.exe
orb/native/**/*.obj
orb/native/**/*.o
# 内嵌 Python 运行时（构建期生成，仅进 Release 二进制，不进仓库）
orb/runtime/
resources/runtime/
resources/asr/
**/LICENSES.chromium.html

# ---------- 6. 备份 / 临时 / 日志 ----------
*.bak
*.bak-*
*.koubak
*.koubak*
*.perfbak*
*.log
*.tmp
*.temp
wb-callback.log
dist-electron-build.log
~$*
Thumbs.db
desktop.ini

# ---------- 6b. 归档 / 旧版桌面端残留 ----------
_desktop_archive/
**/_archive/

# ---------- 7. 截图与调试中间产物 ----------
.ocr-*.png
.selftest-shot.png
.children-*.json
orb/.selftest-shot.png
**/_wbverify*.html
**/_probe.cjs
**/_restart_diag.cjs
**/_slider_diag.cjs
**/_inline_check.cjs

# ---------- 7b. 界面调参对照图（开发过程产物） ----------
# 项目根散落着一批开发期截图：方案三* 圆角/配色候选、极光* 浓淡对照、
# 滑轨错位修复对照、界面文案清理对照、orb-panel-* / orb-sendrow-* / ui_* 等。
# 它们是逐轮调参的中间产物，不是项目资产，公开仓库只保留一张对外预览图。
# 注意 `/*.png` 带前导斜杠，只作用于**项目根这一层**，不会误伤
# orb/desktop/icon.png（托盘/球体/头像三处共用，运行时必需）。
/*.png
!ORB界面预览.png
/*.svg
!ORB界面预览.svg
# orb/ 顶层的中间截图同理
/orb/icon-applied.png
/orb/icon-before-after.png
/orb/orb-ui-final.png
/orb/screenshot-*.png

# ---------- 7c. 本机审批记录 / 一次性调试输出 ----------
# approvals.json 是宿主对本机命令的授权台账，含本机路径与命令原文。
/approvals.json
/watch_question_pending.json
/whatpage.txt

# ---------- 7d. voice_extract 逆向脚本（一次性，全部硬编码本机绝对路径） ----------
# 这批 Python 脚本用于从 app.asar 里提取 WorkBuddy 专有前端产物（voice_extract/，
# 已在 §1 红线排除）。它们除了写死作者机器的盘符与家目录外别无用处，不进仓库。
/orb/context_daemon.py
/orb/context_libchat.py
/orb/context_provider.py
/orb/context_voice.py
/orb/extract2.py
/orb/extract_main.py
/orb/extract_voice.py
/orb/find_voice.py
/orb/scan_voice.py
/orb/asar_voice.py

# ---------- 8. 本机私有脚本 / 一次性实验脚本 ----------
# 根目录的一批一次性调试脚本（nav.mjs / probe*.mjs / watch_*.mjs / hs_*.mjs …）
# 属开发过程产物，随仓库公开前请逐个人工确认；这里先整体排除根目录散落的 .mjs
/*.mjs
!/*.md
# orb/ 下同批一次性脚本：下划线前缀是"开发期临时脚本"的约定（_render_*.mjs 等），
# 里面写死了开发机路径与一次性任务，不该进公开仓库。
orb/_*.mjs

# docs/ 下同约定：`_` 前缀是"一次性核验脚本 / 预览长图"的标记
# （_recbar_verify.js、_tc_smoke.js、_batch_preview.png …），跑了就删的开发副产物。
docs/_*
# 真文档（.md / 说明图）不受影响，仍按需人工 add。

# ---------- 8.5 内部策略文档（2026-10-22 撤出版本库） ----------
# 这些是「对外推广 / 参赛策略 / 竞品调研」的工作底稿：写给自己的，不是给访客看的。
# 留在本地继续用，但不入库 —— 否则会出现在公开 commit 历史里。
docs/涨Star方法-*.md
docs/竞品-*.md
docs/赛事选择-*.md
docs/开放原子大赛*.md
docs/磨砂玻璃-验证截图.png

# 运行时产物：开发态的存储根就是项目根，录屏/截图直接落在这里 ——
# 是用户数据不是源码，别混进仓库（打包态落在 %APPDATA%\ORB 控制台）。
/recordings/
/screenshots/

# ---------- 9. 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store

# 对外宣传文案：QQ 频道帖 / 演示页文案，只留本地
/docs/渠道-*

# 一次性桌面快捷方式修复脚本（不入库）
/fix-desktop-icon.*

# ---------- 3. 红线：TTS 声线工作目录（含真人/角色参照素材） ----------
# tts/ 下存放过从第三方音色库取来的参照音频与其转写、声线设计调研文档
# （文档里含真实声优与动画角色名）。这些既非本项目资产，也不参与构建，
# 一旦随仓库分发即构成对表演者权／录音制作者权的侵害。
# 现用声线改由开源模型按文字描述生成（tts/moss_ref/prompt2），但旧素材
# 的清理与回溯仍留在本机，整个工作目录一律不入库。
tts/
**/moss_ref/
**/试音_*/
**/*.opus
**/*.wav
**/*.raw

# ---------- 4. 离线语音包：构建产物，可再生，不入库 ----------
# orb/desktop/voicepack/ 由 `node tts/_make_voicepack.cjs` 从烘焙产物生成
# （360 条 opus + index.js，约 9MB）。它属于构建产物而非源码：
# 每次改台词都要整目录重生成，入库只会让 git 历史里堆二进制垃圾。
# 注：这些音频本身合规（参照由 MOSS-VoiceGenerator 按纯声学描述生成，
# 非任何真人录音），不进仓库纯粹是体积与可再生的考虑，不是版权原因。
# 从仓库 clone 后要自己打包含语音的 exe，需先跑一次 _make_voicepack.cjs。
/orb/desktop/voicepack/
