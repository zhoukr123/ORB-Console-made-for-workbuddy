{
  "manifest_version": 3,
  "name": "ORB Browser Bridge",
  "version": "1.0.0",
  "description": "ORB 自研浏览器 Provider：通过 com.orb.browser 本地宿主与 ORB 桥通信，安全判定全部在桥侧完成。",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
